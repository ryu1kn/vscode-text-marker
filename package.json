{
  "name": "text-marker",
  "displayName": "Text Marker (Highlighter)",
  "description": "%extension.description%",
  "version": "1.11.0",
  "publisher": "ryu1kn",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "images/text-marker.png",
  "bugs": {
    "url": "https://github.com/ryu1kn/vscode-text-marker/issues"
  },
  "homepage": "https://github.com/ryu1kn/vscode-text-marker/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryu1kn/vscode-text-marker.git"
  },
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mark",
    "marker",
    "match",
    "highlight",
    "search"
  ],
  "telemetryKey": "99489808-a33c-4235-af6d-04f95a652ead",
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "textmarker.highlightColors": {
          "description": "%setting.highlightColors%",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "darkgoldenrod",
            "darkmagenta",
            "darkolivegreen",
            "darkslateblue",
            "darkslategray",
            "darkviolet",
            "darkblue",
            "darkturquoise",
            "darkgray",
            "darkkhaki",
            "darkorange",
            "darksalmon",
            "darkseagreen"
          ]
        },
        "textmarker.defaultHighlightColor": {
          "description": "%setting.defaultHighlightColor%",
          "type": "string",
          "default": "gray"
        },
        "textmarker.defaultHighlightOpacity": {
          "description": "%setting.defaultHighlightOpacity%",
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1
        },
        "textmarker.enableIgnoreCase": {
          "description": "%setting.enableIgnoreCase%",
          "type": "boolean",
          "default": false
        },
        "textmarker.enableWholeMatch": {
          "description": "%setting.enableWholeMatch%",
          "type": "boolean",
          "default": false
        },
        "textmarker.useHighlightColorOnRuler": {
          "description": "%setting.useHighlightColorOnRuler%",
          "type": "boolean",
          "default": true
        },
        "textmarker.autoSelectDistinctiveTextColor": {
          "description": "%setting.autoSelectDistinctiveTextColor%",
          "type": "boolean",
          "default": false
        },
        "textmarker.hideStatusBarItems": {
          "description": "%setting.hideStatusBarItems%",
          "type": "boolean",
          "default": false
        },
        "textmarker.delayForRefreshingHighlight": {
          "description": "%setting.delayForRefreshingHighlight%",
          "type": [
            "number",
            "null"
          ],
          "default": 300
        },
        "textmarker.commandsOnContextMenu": {
          "description": "%setting.commandsOnContextMenu%",
          "type": "object",
          "properties": {
            "highlightUsingRegex": {
              "type": "boolean"
            },
            "toggleHighlight": {
              "type": "boolean"
            },
            "unhighlight": {
              "type": "boolean"
            },
            "toggleCaseSensitivity": {
              "type": "boolean"
            },
            "toggleWholeMatch": {
              "type": "boolean"
            },
            "clearAllHighlight": {
              "type": "boolean"
            },
            "saveAllHighlights": {
              "type": "boolean"
            },
            "updateHighlight": {
              "type": "boolean"
            },
            "goToNextHighlight": {
              "type": "boolean"
            },
            "goToPreviousHighlight": {
              "type": "boolean"
            }
          },
          "default": {
            "highlightUsingRegex": false,
            "toggleHighlight": true,
            "unhighlight": false,
            "toggleCaseSensitivity": false,
            "toggleWholeMatch": false,
            "clearAllHighlight": false,
            "saveAllHighlights": false,
            "updateHighlight": true,
            "goToNextHighlight": true,
            "goToPreviousHighlight": true
          },
          "additionalProperties": false
        },
        "textmarker.savedHighlights": {
          "description": "%setting.savedHighlights%",
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "string",
                      "regex"
                    ]
                  },
                  "expression": {
                    "type": "string"
                  },
                  "ignoreCase": {
                    "type": "boolean"
                  },
                  "wholeMatch": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "expression",
                  "ignoreCase",
                  "wholeMatch"
                ]
              },
              "color": {
                "type": "string"
              }
            },
            "required": [
              "pattern"
            ]
          }
        },
        "textmarker.enableTelemetry": {
          "description": "%setting.enableTelemetry%",
          "type": "boolean",
          "default": true
        },
        "textmarker.borderWidth": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "%setting.borderWidth%"
        },
        "textmarker.borderStyle": {
          "type": "string",
          "default": "solid",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "double",
            "none"
          ],
          "enumDescriptions": [
            "%borderStyle.solid%",
            "%borderStyle.dashed%",
            "%borderStyle.dotted%",
            "%borderStyle.double%",
            "%borderStyle.none%"
          ],
          "description": "%setting.borderStyle%"
        },
        "textmarker.borderRadius": {
          "type": "number",
          "default": 999,
          "minimum": 0,
          "description": "%setting.borderRadius%"
        }
      }
    },
    "commands": [
      {
        "command": "textmarker.highlightUsingRegex",
        "title": "%command.highlightUsingRegex%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.toggleHighlight",
        "title": "%command.toggleHighlight%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.unhighlight",
        "title": "%command.unhighlight%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.toggleCaseSensitivity",
        "title": "%command.toggleCaseSensitivity%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.toggleModeForCaseSensitivity",
        "title": "%command.toggleModeForCaseSensitivity%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.toggleWholeMatch",
        "title": "%command.toggleWholeMatch%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.toggleModeForWholeMatch",
        "title": "%command.toggleModeForWholeMatch%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.clearAllHighlight",
        "title": "%command.clearAllHighlight%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.saveAllHighlights",
        "title": "%command.saveAllHighlights%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.updateHighlight",
        "title": "%command.updateHighlight%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.goToNextHighlight",
        "title": "%command.goToNextHighlight%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.goToPreviousHighlight",
        "title": "%command.goToPreviousHighlight%",
        "category": "TextMarker"
      },
      {
        "command": "textmarker.highlightCyan",
        "title": "%command.highlightCyan%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      },
      {
        "command": "textmarker.highlightBlue",
        "title": "%command.highlightBlue%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      },
      {
        "command": "textmarker.highlightYellow",
        "title": "%command.highlightYellow%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      },
      {
        "command": "textmarker.highlightPurple",
        "title": "%command.highlightPurple%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      },
      {
        "command": "textmarker.highlightGreen",
        "title": "%command.highlightGreen%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      },
      {
        "command": "textmarker.highlightRed",
        "title": "%command.highlightRed%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      },
      {
        "command": "textmarker.highlightPink",
        "title": "%command.highlightPink%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      },
      {
        "command": "textmarker.highlightLime",
        "title": "%command.highlightLime%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      },
      {
        "command": "textmarker.highlightTeal",
        "title": "%command.highlightTeal%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      },
      {
        "command": "textmarker.highlightSilver",
        "title": "%command.highlightSilver%",
        "category": "TextMarker",
        "enablement": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "textmarker.toggleHighlight",
          "group": "2_textmarker@1",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.toggleHighlight"
        },
        {
          "command": "textmarker.updateHighlight",
          "group": "2_textmarker@2",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.updateHighlight"
        },
        {
          "command": "textmarker.goToNextHighlight",
          "group": "2_textmarker@3",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.goToNextHighlight"
        },
        {
          "command": "textmarker.goToPreviousHighlight",
          "group": "2_textmarker@4",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.goToPreviousHighlight"
        },
        {
          "command": "textmarker.highlightUsingRegex",
          "group": "2_textmarker@5",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.highlightUsingRegex"
        },
        {
          "command": "textmarker.unhighlight",
          "group": "2_textmarker@6",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.unhighlight"
        },
        {
          "command": "textmarker.toggleCaseSensitivity",
          "group": "2_textmarker@7",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.toggleCaseSensitivity"
        },
        {
          "command": "textmarker.toggleWholeMatch",
          "group": "2_textmarker@8",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.toggleWholeMatch"
        },
        {
          "command": "textmarker.clearAllHighlight",
          "group": "2_textmarker@9",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.clearAllHighlight"
        },
        {
          "command": "textmarker.saveAllHighlights",
          "group": "2_textmarker@10",
          "when": "editorTextFocus && config.textmarker.commandsOnContextMenu.saveAllHighlights"
        },
        {
          "submenu": "textmarker.highlightColours",
          "group": "2_textmarker@0",
          "when": "editorTextFocus"
        }
      ],
      "textmarker.highlightColours": [
        {
          "command": "textmarker.highlightCyan",
          "group": "1_colours@1"
        },
        {
          "command": "textmarker.highlightBlue",
          "group": "1_colours@2"
        },
        {
          "command": "textmarker.highlightYellow",
          "group": "1_colours@3"
        },
        {
          "command": "textmarker.highlightPurple",
          "group": "1_colours@4"
        },
        {
          "command": "textmarker.highlightGreen",
          "group": "1_colours@5"
        },
        {
          "command": "textmarker.highlightRed",
          "group": "1_colours@6"
        },
        {
          "command": "textmarker.highlightPink",
          "group": "1_colours@7"
        },
        {
          "command": "textmarker.highlightLime",
          "group": "1_colours@8"
        },
        {
          "command": "textmarker.highlightTeal",
          "group": "1_colours@9"
        },
        {
          "command": "textmarker.highlightSilver",
          "group": "1_colours@10"
        }
      ]
    },
    "submenus": [
      {
        "id": "textmarker.highlightColours",
        "label": "%menu.highlightColours%"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "vscode:postpublish": "./tag-release.sh",
    "coverage": "nyc mocha \"src/test/**/*.test.ts\"",
    "compile": "tsc -p ./",
    "lint": "tslint -p .",
    "check": "npm run compile && npm run lint && npm test",
    "watch": "tsc -watch -p ./",
    "test": "mocha \"src/test/**/*.test.ts\"",
    "unit-test": "mocha \"src/test/unit/**/*.test.ts\"",
    "acceptance-test": "mocha \"src/test/acceptance/**/*.test.ts\"",
    "test-mode": "mocha \"src/test/unit/**/*.test.ts\" --watch"
  },
  "devDependencies": {
    "@types/mocha": "^8.0.4",
    "@types/node": "^12.14.1",
    "codeclimate-test-reporter": "^0.5.1",
    "mocha": "^8.2.1",
    "nyc": "^15.1.0",
    "testdouble": "^3.13.1",
    "ts-node": "^9.0.0",
    "tslint": "^6.1.3",
    "typescript": "^4.1.2",
    "@types/vscode": "1.73.0"
  },
  "dependencies": {
    "color-name": "1.1.4",
    "color-rgba": "2.2.3",
    "fp-ts": "2.9.0",
    "lodash.isnumber": "3.0.3",
    "uuid": "3.3.3",
    "vscode-extension-telemetry": "0.0.22"
  },
  "resolutions": {
    "**/minimist": "^1.2.5"
  },
  "l10n": "./l10n"
}
